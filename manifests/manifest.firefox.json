{
  "manifest_version": 3,
  "name": "TimeFocuser — In-Browser Site Firewall",
  "version": "1.0.0",
  "description": "Firewall-grade website blocker with time-based schedules, tamper-resistant security, and locked settings during focus periods.",
  "browser_specific_settings": {
    "gecko": {
      "id": "timefocuser@extension.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "TimeFocuser Firewall"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://docs.google.com;"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/blocked/index.html", "src/goodbye/index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
