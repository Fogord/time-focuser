{
  "manifest_version": 3,
  "name": "TimeFocuser — In-Browser Site Firewall",
  "version": "1.0.0",
  "description": "Firewall-grade website blocker with time-based schedules, tamper-resistant security, and locked settings during focus periods.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "TimeFocuser Firewall"
  },
  "options_page": "src/options/index.html",
  "web_accessible_resources": [
    {
      "resources": ["src/blocked/index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
